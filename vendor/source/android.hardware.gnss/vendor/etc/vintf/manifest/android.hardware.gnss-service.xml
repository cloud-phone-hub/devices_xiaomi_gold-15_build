<!--
    gold 自研 gnss HAL（虚拟 HAL）：底座未提供 AIDL IGnss，故由本服务声明 IGnss/default（v4），
    LocationManager 据此创建 gps provider（真机为 gnss-default.xml 同款声明）。
-->
<manifest version="1.0" type="device">
  <hal format="aidl">
    <name>android.hardware.gnss</name>
    <version>4</version>
    <fqname>IGnss/default</fqname>
  </hal>
</manifest>
