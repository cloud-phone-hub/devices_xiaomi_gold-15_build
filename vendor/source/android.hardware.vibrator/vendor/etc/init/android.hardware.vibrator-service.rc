# gold 自研 vibrator HAL（虚拟 HAL）：接管 android.hardware.vibrator.IVibrator/default
# 与 IVibratorManager/default，按机型能力清单 /vendor/etc/cfg/cdh_vibrator.cfg 上报。
# on/perform 仅即时成功（不驱动宿主振动，也不影响 guest 输入设备），
# capabilitiesFlags = 0 时不宣称 amplitude control、不触发回调。
# 底座可能已带 vibrator 定义，故 disabled + 晚启动，避免同名服务冲突。
service vendor.vibrator-default /vendor/bin/hw/android.hardware.vibrator-service
    class hal
    user system
    group system
    seclabel u:r:hal_vibrator_default:s0
    interface aidl android.hardware.vibrator.IVibrator/default
    interface aidl android.hardware.vibrator.IVibratorManager/default
    disabled

on post-fs-data
    start vendor.vibrator-default
