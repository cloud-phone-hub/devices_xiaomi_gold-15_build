<!--
    gold 自研 lights HAL：lineage/MTK 底座未提供 AIDL ILights，故由本服务声明
    ILights/default（v2），LightsService 据此枚举灯（清单见 /vendor/etc/cfg/cdh_light.cfg）。
-->
<manifest version="1.0" type="device">
  <hal format="aidl">
    <name>android.hardware.light</name>
    <version>2</version>
    <fqname>ILights/default</fqname>
  </hal>
</manifest>
